{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "studio.syntance.com"
        }
      ],
      "destination": "/studio"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "studio.syntance.com"
        }
      ],
      "destination": "/studio/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/studio-retention",
      "schedule": "15 3 * * *"
    }
  ]
}
